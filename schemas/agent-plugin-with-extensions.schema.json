{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.lbke.fr/schemas/agent-plugin-with-extensions.schema.json",
  "title": "OpenAI Agent Plugins manifest extension",
  "description": "Local validation schema for the OpenAI-specific `extensions.com.openai` block. It extends the canonical Agent Plugins manifest schema without replacing its base rules.",
  "type": "object",
  "allOf": [
    {
      "$ref": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json"
    }
  ],
  "properties": {
    "extensions": {
      "type": "object",
      "properties": {
        "com.openai": {
          "$ref": "#/$defs/comOpenAI"
        }
      },
      "additionalProperties": {
        "type": "object"
      }
    }
  },
  "$defs": {
    "comOpenAI": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "interface": {
          "$ref": "#/$defs/interface"
        },
        "onboardingSkill": {
          "type": "string",
          "minLength": 1,
          "description": "Relative path to a skill used for setup onboarding."
        },
        "review": {
          "$ref": "#/$defs/review"
        },
        "publication": {
          "$ref": "#/$defs/publication"
        }
      }
    },
    "interface": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "displayName",
        "shortDescription",
        "longDescription",
        "developerName",
        "category"
      ],
      "properties": {
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 30,
          "description": "Public listing name shown to users."
        },
        "shortDescription": {
          "type": "string",
          "minLength": 1,
          "maxLength": 30,
          "description": "Subtitle shown with the plugin name."
        },
        "longDescription": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000,
          "description": "Detailed plugin description."
        },
        "developerName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "description": "Publisher or company name."
        },
        "category": {
          "type": "string",
          "enum": [
            "Productivity",
            "Creativity",
            "Developer Tools",
            "Business & Operations",
            "Data & Analytics",
            "Communication",
            "Education & Research",
            "Security",
            "Finance",
            "Healthcare",
            "Travel",
            "Entertainment",
            "Other"
          ],
          "description": "OpenAI-supported plugin category."
        },
        "capabilities": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "maxItems": 20,
          "description": "Capability labels shown in the listing."
        },
        "websiteURL": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://.*$",
          "maxLength": 1024,
          "description": "HTTPS product website."
        },
        "supportURL": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://.*$",
          "maxLength": 1024,
          "description": "HTTPS support resource."
        },
        "privacyPolicyURL": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://.*$",
          "maxLength": 1024,
          "description": "HTTPS privacy policy."
        },
        "termsOfServiceURL": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://.*$",
          "maxLength": 1024,
          "description": "HTTPS terms of service page."
        },
        "defaultPrompt": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "minItems": 1,
              "maxItems": 3
            }
          ],
          "description": "Starter prompt(s); up to three prompts are allowed."
        },
        "brandColor": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$",
          "description": "Primary light-theme brand color."
        },
        "brandColorDark": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$",
          "description": "Dark-theme brand color."
        },
        "composerIcon": {
          "type": "string",
          "minLength": 1,
          "description": "Relative path to the composer icon asset."
        },
        "composerIconDark": {
          "type": "string",
          "minLength": 1,
          "description": "Relative path to the dark composer icon asset."
        },
        "logo": {
          "type": "string",
          "minLength": 1,
          "description": "Relative path to the primary listing logo."
        },
        "logoDark": {
          "type": "string",
          "minLength": 1,
          "description": "Relative path to the dark listing logo asset."
        },
        "screenshots": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Relative paths to screenshot assets."
        }
      }
    },
    "reviewTestCase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["description", "prompt"],
      "properties": {
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "prompt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "tools_triggered": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "expected_behavior": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "file_attachment_urls": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://.*$"
          },
          "maxItems": 10
        },
        "expected_output_url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://.*$"
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "test_cases": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "positive": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/reviewTestCase"
              },
              "maxItems": 5
            },
            "negative": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/reviewTestCase"
              },
              "maxItems": 3
            }
          }
        },
        "demo_recording_url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://.*$",
          "maxLength": 2048
        },
        "commerce": {
          "type": "boolean"
        },
        "commerce_description": {
          "type": "string",
          "maxLength": 4000
        }
      }
    },
    "publication": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "countries": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Z]{2}$"
          },
          "description": "Allowlisted publishing countries in ISO 3166-1 alpha-2 format."
        },
        "release_notes": {
          "type": "string",
          "maxLength": 4000
        },
        "translations": {
          "type": "object",
          "patternProperties": {
            "^[A-Za-z]{2,3}-[A-Za-z0-9]{2,}$": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "subtitle": {
                  "type": ["string", "null"],
                  "maxLength": 30
                },
                "description": {
                  "type": ["string", "null"],
                  "maxLength": 4000
                }
              }
            }
          },
          "description": "Localized listing translations keyed by locale code."
        }
      }
    }
  }
}
